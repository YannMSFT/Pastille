<Window x:Class="Pastille.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pastille"
        Title="{local:Loc ConfigurationTitle}" Width="480" Height="820" MinWidth="440" MinHeight="620" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#F4F7FA" FontFamily="Segoe UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Pastille" FontSize="32" FontWeight="SemiBold" Foreground="#132C39"/>
      <TextBlock Text="{local:Loc Tagline}" Foreground="#526470" Margin="0,0,0,20"/>
      <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="{local:Loc WebcamHeading}" Foreground="#42616C" FontWeight="SemiBold"/>
          <ComboBox x:Name="CameraChoice" DisplayMemberPath="Name"/>
          <WrapPanel>
            <Button x:Name="CameraButton" Content="{local:Loc StartCamera}" Click="CameraClick"/>
            <Button x:Name="RefreshButton" Content="{local:Loc Refresh}" Click="RefreshClick"/>
          </WrapPanel>
          <TextBlock Text="{local:Loc Privacy}" FontSize="12" Foreground="#526470"/>
        </StackPanel>
      </Border>
      <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="{local:Loc OverlayHeading}" Foreground="#42616C" FontWeight="SemiBold"/>
          <WrapPanel Margin="0,10,0,10">
            <RadioButton x:Name="OvalChoice" Content="{local:Loc Oval}" GroupName="Shape" Margin="0,0,24,0" Checked="ShapeChanged"/>
            <RadioButton x:Name="RectangleChoice" Content="{local:Loc Rectangle}" GroupName="Shape" Checked="ShapeChanged"/>
          </WrapPanel>
          <CheckBox x:Name="MirrorChoice" Content="{local:Loc Mirror}" Checked="MirrorChanged" Unchecked="MirrorChanged" Margin="0,0,0,10"/>
          <TextBlock Text="{local:Loc Outline}" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <CheckBox x:Name="OutlineChoice" Content="{local:Loc ShowOutline}" Checked="OutlineChanged" Unchecked="OutlineChanged" Margin="0,0,0,8"/>
          <DockPanel>
            <TextBlock Text="{local:Loc Thickness}" Width="90"/>
            <TextBlock x:Name="OutlineThicknessLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="OutlineThicknessSlider" Minimum="1" Maximum="20" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="OutlineThicknessChanged"/>
          </DockPanel>
          <WrapPanel Margin="0,8,0,12">
            <Button x:Name="OutlineColorButton" Content="{local:Loc PickColor}" Click="OutlineColorClick"/>
            <Border x:Name="OutlineColorSwatch" Width="24" Height="24" BorderBrush="#526470" BorderThickness="1" Margin="0,0,8,0"/>
            <TextBlock x:Name="OutlineColorLabel" VerticalAlignment="Center"/>
          </WrapPanel>
          <TextBlock Text="{local:Loc RectangleCorners}" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DockPanel>
            <TextBlock Text="{local:Loc Radius}" Width="90"/>
            <TextBlock x:Name="CornerRadiusLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="200" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="CornerRadiusChanged"/>
          </DockPanel>
          <TextBlock Text="{local:Loc RadiusHelp}"
                     FontSize="12" Foreground="#526470" Margin="0,6,0,12"/>
          <TextBlock Text="{local:Loc Framing}" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DockPanel>
            <TextBlock Text="{local:Loc Zoom}" Width="90"/>
            <TextBlock x:Name="ZoomLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="4" Value="1"
                    SmallChange="0.05" ValueChanged="FramingChanged"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock Text="{local:Loc Horizontal}" Width="90"/>
            <TextBlock x:Name="PanXLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="PanXSlider" Minimum="-1" Maximum="1" SmallChange="0.05" ValueChanged="FramingChanged"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock Text="{local:Loc Vertical}" Width="90"/>
            <TextBlock x:Name="PanYLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="PanYSlider" Minimum="-1" Maximum="1" SmallChange="0.05" ValueChanged="FramingChanged"/>
          </DockPanel>
          <Button Content="{local:Loc ResetFraming}" Click="ResetFramingClick" HorizontalAlignment="Left"/>
          <TextBlock Text="{local:Loc FramingHelp}"
                     FontSize="12" Foreground="#526470" Margin="0,0,0,12"/>
          <TextBlock Text="{local:Loc OverlaySize}" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DockPanel>
            <TextBlock Text="{local:Loc Width}" Width="72"/>
            <TextBlock x:Name="WidthLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="WidthSlider" Minimum="120" Maximum="960" ValueChanged="SizeChangedByUser"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock Text="{local:Loc Height}" Width="72"/>
            <TextBlock x:Name="HeightLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="HeightSlider" Minimum="90" Maximum="720" ValueChanged="SizeChangedByUser"/>
          </DockPanel>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="{local:Loc CenterOverlay}" Click="CenterOverlayClick"/>
            <CheckBox x:Name="VisibleChoice" Content="{local:Loc ShowOverlay}" IsChecked="True" VerticalAlignment="Center"
                      Checked="VisibilityChanged" Unchecked="VisibilityChanged"/>
          </WrapPanel>
          <TextBlock Text="{local:Loc MoveHelp}"
                     FontSize="12" Foreground="#526470"/>
        </StackPanel>
      </Border>
      <Border Background="White" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="{local:Loc DisplayHeading}" Foreground="#42616C" FontWeight="SemiBold"/>
          <TextBlock x:Name="HotkeyLabel" Text="{local:Loc Hotkey}" FontWeight="SemiBold" Margin="0,10,0,6"/>
          <TextBlock Text="{local:Loc HotkeyHelp}"
                     FontSize="12" Foreground="#526470"/>
          <Button x:Name="ToggleVisibilityButton" Content="{local:Loc HideOverlay}" Click="ToggleVisibilityClick" HorizontalAlignment="Left"/>
          <TextBlock x:Name="StatusLabel" Text="{local:Loc Ready}" FontWeight="SemiBold" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="{local:Loc TrayHelp}"
                 Foreground="#526470" FontSize="12" Margin="0,14,0,0"/>
      <Button Content="{local:Loc CloseSettings}" Click="HideConfigurationClick" HorizontalAlignment="Left"/>
      <TextBlock Text="{local:Loc Footer}"
                 Foreground="#526470" FontSize="12" Margin="0,14,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
