<Window x:Class="Pastille.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pastille — configuration" Width="480" Height="820" MinWidth="440" MinHeight="620" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#F4F7FA" FontFamily="Segoe UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Pastille" FontSize="32" FontWeight="SemiBold" Foreground="#132C39"/>
      <TextBlock Text="Votre webcam, au-dessus de vos applications." Foreground="#526470" Margin="0,0,0,20"/>
      <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="WEBCAM" Foreground="#42616C" FontWeight="SemiBold"/>
          <ComboBox x:Name="CameraChoice" DisplayMemberPath="Name"/>
          <WrapPanel>
            <Button x:Name="CameraButton" Content="Activer la webcam" Click="CameraClick"/>
            <Button x:Name="RefreshButton" Content="Actualiser" Click="RefreshClick"/>
          </WrapPanel>
          <TextBlock Text="Aucune image n'est envoyée sur Internet." FontSize="12" Foreground="#526470"/>
        </StackPanel>
      </Border>
      <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="PASTILLE" Foreground="#42616C" FontWeight="SemiBold"/>
          <WrapPanel Margin="0,10,0,10">
            <RadioButton x:Name="OvalChoice" Content="Ovale" GroupName="Shape" Margin="0,0,24,0" Checked="ShapeChanged"/>
            <RadioButton x:Name="RectangleChoice" Content="Rectangle" GroupName="Shape" Checked="ShapeChanged"/>
          </WrapPanel>
          <CheckBox x:Name="MirrorChoice" Content="Effet miroir" Checked="MirrorChanged" Unchecked="MirrorChanged" Margin="0,0,0,10"/>
          <TextBlock Text="Liseré" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <CheckBox x:Name="OutlineChoice" Content="Afficher le liseré" Checked="OutlineChanged" Unchecked="OutlineChanged" Margin="0,0,0,8"/>
          <DockPanel>
            <TextBlock Text="Épaisseur" Width="90"/>
            <TextBlock x:Name="OutlineThicknessLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="OutlineThicknessSlider" Minimum="1" Maximum="20" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="OutlineThicknessChanged"/>
          </DockPanel>
          <WrapPanel Margin="0,8,0,12">
            <Button x:Name="OutlineColorButton" Content="Choisir la couleur…" Click="OutlineColorClick"/>
            <Border x:Name="OutlineColorSwatch" Width="24" Height="24" BorderBrush="#526470" BorderThickness="1" Margin="0,0,8,0"/>
            <TextBlock x:Name="OutlineColorLabel" VerticalAlignment="Center"/>
          </WrapPanel>
          <TextBlock Text="Arrondi du rectangle" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DockPanel>
            <TextBlock Text="Rayon" Width="90"/>
            <TextBlock x:Name="CornerRadiusLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="200" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="CornerRadiusChanged"/>
          </DockPanel>
          <TextBlock Text="0 : angles droits. Disponible en mode Rectangle. L'arrondi est limité à la moitié du plus petit côté."
                     FontSize="12" Foreground="#526470" Margin="0,6,0,12"/>
          <TextBlock Text="Cadrage du visage" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DockPanel>
            <TextBlock Text="Zoom" Width="90"/>
            <TextBlock x:Name="ZoomLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="4" Value="1"
                    SmallChange="0.05" ValueChanged="FramingChanged"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Horizontal" Width="90"/>
            <TextBlock x:Name="PanXLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="PanXSlider" Minimum="-1" Maximum="1" SmallChange="0.05" ValueChanged="FramingChanged"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Vertical" Width="90"/>
            <TextBlock x:Name="PanYLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="PanYSlider" Minimum="-1" Maximum="1" SmallChange="0.05" ValueChanged="FramingChanged"/>
          </DockPanel>
          <Button Content="Réinitialiser le cadrage" Click="ResetFramingClick" HorizontalAlignment="Left"/>
          <TextBlock Text="Le zoom et le cadrage déplacent l'image à l'intérieur de la pastille, sans déplacer celle-ci. La molette sur la pastille règle aussi le zoom."
                     FontSize="12" Foreground="#526470" Margin="0,0,0,12"/>
          <TextBlock Text="Taille de la pastille" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DockPanel>
            <TextBlock Text="Largeur" Width="72"/>
            <TextBlock x:Name="WidthLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="WidthSlider" Minimum="120" Maximum="960" ValueChanged="SizeChangedByUser"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Hauteur" Width="72"/>
            <TextBlock x:Name="HeightLabel" DockPanel.Dock="Right" Width="58" TextAlignment="Right"/>
            <Slider x:Name="HeightSlider" Minimum="90" Maximum="720" ValueChanged="SizeChangedByUser"/>
          </DockPanel>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Recentrer la pastille" Click="CenterOverlayClick"/>
            <CheckBox x:Name="VisibleChoice" Content="Afficher la pastille" IsChecked="True" VerticalAlignment="Center"
                      Checked="VisibilityChanged" Unchecked="VisibilityChanged"/>
          </WrapPanel>
          <TextBlock Text="Glissez la pastille pour la déplacer. Sa poignée inférieure permet de la redimensionner. Double-cliquez pour retrouver les commandes."
                     FontSize="12" Foreground="#526470"/>
        </StackPanel>
      </Border>
      <Border Background="White" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="AFFICHAGE" Foreground="#42616C" FontWeight="SemiBold"/>
          <TextBlock x:Name="HotkeyLabel" Text="Ctrl + Maj + F9 : cacher / afficher la pastille" FontWeight="SemiBold" Margin="0,10,0,6"/>
          <TextBlock Text="Fonctionne depuis les autres applications, même lorsque la configuration est fermée. La webcam reste active pendant que la pastille est cachée."
                     FontSize="12" Foreground="#526470"/>
          <Button x:Name="ToggleVisibilityButton" Content="Cacher la pastille" Click="ToggleVisibilityClick" HorizontalAlignment="Left"/>
          <TextBlock x:Name="StatusLabel" Text="Prêt." FontWeight="SemiBold" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Pastille reste dans la zone de notification près de l'horloge. Clic droit sur son icône : Configuration, afficher/cacher la pastille, Quitter. Fermer cette fenêtre ne quitte pas Pastille."
                 Foreground="#526470" FontSize="12" Margin="0,14,0,0"/>
      <Button Content="Fermer la configuration" Click="HideConfigurationClick" HorizontalAlignment="Left"/>
      <TextBlock Text="Natif ARM64 · webcam locale · aucun enregistrement ni accès au microphone"
                 Foreground="#526470" FontSize="12" Margin="0,14,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
